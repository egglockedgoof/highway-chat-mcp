# Copy to .env for local runs. Never put real secrets in git.
# .env is gitignored. Render dashboard holds production values.

# --- Required to boot ---
FIREBASE_API_KEY=
MCP_SECRET=
HIGHWAY_CLIENT_KEY=

# Firebase email/password for each bot. JSON object, names match MCP_CALLERS.
# BOT_CREDENTIALS={"whisper":{"email":"bot@example.com","password":"replace-me"}}
BOT_CREDENTIALS=

# Per-agent Bearer tokens. JSON object token -> bot name. Each token must be 16+ chars.
# MCP_CALLERS={"replace-with-a-token-at-least-16-chars":"whisper"}
MCP_CALLERS=

# "on" = shared path secret /mcp/<MCP_SECRET> still works (any name).
# "off" = Bearer-only. Requires MCP_CALLERS. Do not flip until every bot has a token.
LEGACY_PATH_AUTH=on

# POST /upload: comma-separated team emails, matched case-insensitively.
# Unset, empty, or whitespace-only = fail closed (every upload 403).
# Do not commit real addresses.
UPLOAD_ALLOWED_EMAILS=

# --- Read cache / quota meter ---
READ_CACHE_TTL_MS=15000
READ_BUDGET_DAILY=20000

# --- Optional: shared brain (Pinecone) ---
PINECONE_API_KEY=
BRAIN_INDEX=marrow-brain
BRAIN_NAMESPACE=shared

# --- Optional: team skills ---
# If unset, derived from MCP_SECRET. Set a dedicated key in production.
SKILLS_SIGNING_KEY=
SKILL_APPROVERS=hollow

# --- Optional: uploads (Cloudinary). If unset, inline uploads fail closed. ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Optional: paid Apify tools ---
APIFY_API_TOKEN=

# --- Optional: Postgres (unset = no LISTEN / Firestore-only store; live default) ---
# DATABASE_URL=
# DATABASE_URL_FALLBACK=
# DB_SCHEMA=highway
# STORE_BACKEND=firestore
# STORE_DUAL_WRITE=0

# --- Optional overrides ---
# FIRESTORE_BASE=https://firestore.googleapis.com/v1/projects/highway-chat/databases/(default)/documents
# PORT=3000

# Local tests only. Never set on Render.
# PHASE3_TEST=1

# --- Post-deploy smoke (scripts/smoke.ts). Not used by the bridge itself. ---
# SMOKE_BASE_URL=https://highway-chat-mcp.onrender.com
# SMOKE_TOKEN=
# SMOKE_BOT_NAME=whisper
# SMOKE_PATH_SECRET=
# SMOKE_CHANNEL=code
